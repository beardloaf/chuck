# Copy to .env.local for local dev, and set these in the Vercel project too.

# Admin gate token (moderation login). Use something long and random.
ADMIN_TOKEN=change-me

# --- Production only (Vercel). Leave unset locally to use the on-disk SQLite. ---

# Turso (libSQL) database — the source of truth on Vercel.
# Create with the Turso CLI:  turso db create chuck  /  turso db show --url chuck
#                             turso db tokens create chuck
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — where uploaded media is stored on Vercel.
# Created automatically when you add a Blob store to the Vercel project, or:
#   vercel blob store add
BLOB_READ_WRITE_TOKEN=
